#!/usr/bin/env sh
# Fallback gradlew: if wrapper jar missing, use system gradle
APP_HOME=$( cd "${0%/*}" && pwd -P )
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ -f "$WRAPPER_JAR" ]; then
  # Use wrapper
  if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
  else
    JAVACMD="java"
  fi
  exec "$JAVACMD" -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
else
  echo "Wrapper jar not found, falling back to system gradle"
  exec gradle "$@"
fi
